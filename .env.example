# Copia este archivo a `.env` y ajusta los valores. `.env` está en .gitignore: no lo subas.
# mibici_mlops_module/config.py lee estas variables con python-dotenv.

# Servidor de MLflow. Si se omite se usa la base local sqlite:///mlflow.db
# Si el servidor pide autenticación, define aquí el usuario y la contraseña (nunca en el código).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
